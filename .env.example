# Copy this file to .env.local and fill in the values.

# Random long random string - used to sign login sessions.
# Generate one with: openssl rand -base64 32
JWT_SECRET=

# Reddit app credentials - create at https://www.reddit.com/prefs/apps
# Choose app type "web app". Redirect URI must exactly match REDDIT_REDIRECT_URI below.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=http://localhost:3000/api/auth/reddit/callback

# Anthropic API key - from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Secret used to protect the /api/run-scheduler endpoint from public calls.
# Generate one with: openssl rand -base64 32
CRON_SECRET=

# Stripe - from https://dashboard.stripe.com/apikeys (use TEST keys while developing)
STRIPE_SECRET_KEY=
# Price ID of your monthly Pro subscription product - create at
# https://dashboard.stripe.com/products
STRIPE_PRICE_ID=
# From https://dashboard.stripe.com/webhooks after adding an endpoint
# pointing at /api/billing/webhook (see README for the local testing flow)
STRIPE_WEBHOOK_SECRET=

# X (Twitter) - create an OAuth 2.0 app at https://developer.twitter.com
# (Basic project, "Web App" type). Enable OAuth 2.0, set the redirect URI
# below in the app settings, and load credits into your developer account
# (pay-per-use, no free tier as of Feb 2026 — roughly $0.015/post).
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=http://localhost:3000/api/auth/twitter/callback

# Facebook and Lemmy need no app-level env vars — users paste their own
# Page Access Token (Facebook) or instance login (Lemmy) per-connection.

# Email (password reset) - optional. Without this set, reset emails are
# printed to the server console instead of actually sent (fine for local
# dev/testing). Get a key at https://resend.com
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
